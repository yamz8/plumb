pkgname=plumb
pkgver=0.1.0
pkgrel=1
pkgdesc='Quantity takeoff on construction drawings: lengths, areas, and counts to CSV'
arch=('x86_64' 'aarch64')
url='https://github.com/yamz8/plumb'
license=('MIT')
install='plumb.install'
options=('!debug')
# Qt PDF ships in qt6-webengine on Arch.
depends=(
  'hicolor-icon-theme'
  'qt6-base>=6.9'
  'qt6-declarative>=6.9'
  'qt6-svg'
  'qt6-wayland'
  'qt6-webengine'
  'xdg-desktop-portal'
)
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/plumb "$pkgdir/usr/bin/plumb"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/plumb.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/plumb.svg"
  install -Dm644 "$startdir/plumb.desktop" "$pkgdir/usr/share/applications/plumb.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
